@page "/account"
@inject ApiClient Api

<PageTitle>@L["Nav_Account"] - @L["AppName"]</PageTitle>

<h1>@L["Nav_Account"]</h1>

<AuthorizeView Context="auth">
    <section class="card">
        <dl>
            <dt>@L["Account_CurrentUser"]</dt>
            <dd>@auth.User.Identity?.Name</dd>
            <dt>@L["Account_AuthSource"]</dt>
            <dd>@L["AuthSource_" + AuthSourceOf(auth)]</dd>
        </dl>
    </section>

    <section class="card">
        <h2>@L["Account_ChangePassword"]</h2>
        @if (_message is not null)
        {
            <p class="notice @(_succeeded ? "ok" : "error")">@_message</p>
        }
        <EditForm Model="_form" OnSubmit="() => ChangeAsync(auth)" FormName="change-password" class="grid-form">
            <label>
                @L["Account_NewPassword"]
                <InputText type="password" @bind-Value="_form.NewPassword" autocomplete="new-password" />
                <span class="hint">@L["Common_PasswordRule"]</span>
            </label>
            <label>
                @L["Account_ConfirmPassword"]
                <InputText type="password" @bind-Value="_form.Confirm" autocomplete="new-password" />
            </label>
            <div class="form-actions">
                <button type="submit" class="primary" disabled="@_busy">@L["Account_ChangePassword"]</button>
            </div>
        </EditForm>
    </section>
</AuthorizeView>

@code {
    private const int MinPasswordLength = 12;

    private PasswordForm _form = new();
    private bool _busy;
    private bool _succeeded;
    private string? _message;

    private static string AuthSourceOf(AuthenticationState auth) =>
        auth.User.FindFirst(AuthConstants.AuthSourceClaim)?.Value ?? AuthSources.Database;

    private async Task ChangeAsync(AuthenticationState auth)
    {
        _succeeded = false;
        if (_form.NewPassword.Length < MinPasswordLength)
        {
            _message = L["Common_PasswordRule"];
            return;
        }
        if (_form.NewPassword != _form.Confirm)
        {
            _message = L["Account_Mismatch"];
            return;
        }

        _busy = true;
        try
        {
            await Api.ChangePasswordAsync(
                auth.User.Identity!.Name!, _form.NewPassword, emergency: AuthSourceOf(auth) == AuthSources.Emergency);
            _succeeded = true;
            _message = L["Account_Changed"];
            _form = new PasswordForm();
        }
        catch (ApiException ex)
        {
            _message = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private sealed class PasswordForm
    {
        public string NewPassword { get; set; } = "";
        public string Confirm { get; set; } = "";
    }
}
