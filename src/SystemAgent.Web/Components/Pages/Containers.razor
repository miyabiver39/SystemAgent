@page "/containers"
@using SystemAgent.Core.CapabilityProviders
@inherits NodeScopedPage

<PageTitle>@L["Containers_Title"] - @L["AppName"]</PageTitle>

<h1>@L["Containers_Title"]</h1>

@if (_unavailable is not null)
{
    <p class="notice warn">@L["Containers_Unavailable"] @_unavailable</p>
    return;
}

@if (_runtime is not null)
{
    <p class="hint">@L["Containers_Runtime"]: @_runtime.Name @_runtime.Version（@L["Containers_Template"]: @_runtime.TemplateId）</p>
}
<OperationNotices Operation="_op" />

<section>
    <div class="section-header">
        <h2>@L["Containers_Containers"]</h2>
        <label class="checkbox"><input type="checkbox" @bind="_showInfra" /> @L["Containers_ShowInfra"]</label>
        <button type="button" class="link" @onclick="LoadListsAsync">@L["Common_Reload"]</button>
    </div>
    @if (_containers is null)
    {
        <p class="muted">@L["Common_Loading"]</p>
    }
    else if (VisibleContainers.Count == 0)
    {
        <p class="muted">@L["Containers_Empty"]</p>
    }
    else
    {
        <table>
            <thead>
                <tr>
                    <th>@L["Containers_Name"]</th>
                    <th>@L["Containers_Image"]</th>
                    <th>@L["Containers_State"]</th>
                    <th>@L["Containers_Status"]</th>
                    @if (_runtime?.SupportsPods == true)
                    {
                        <th>Pod</th>
                    }
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in VisibleContainers)
                {
                    <tr @key="c.Id">
                        <td>@c.Name<div class="hint mono">@Formatting.ShortId(c.Id)</div></td>
                        <td class="mono">@c.Image</td>
                        <td><span class="badge state-@c.State.ToString().ToLowerInvariant()">@L["State_" + c.State]</span></td>
                        <td>@c.Status</td>
                        @if (_runtime?.SupportsPods == true)
                        {
                            <td>@c.Pod</td>
                        }
                        <td>
                            @if (_busyId == c.Id)
                            {
                                <span class="muted">@L["Common_Processing"]</span>
                            }
                            else
                            {
                                @if (c.State == ContainerState.Running)
                                {
                                    <button type="button" class="link" @onclick='() => ActAsync(c, "stop")'>@L["Containers_Stop"]</button>
                                    <button type="button" class="link" @onclick='() => ActAsync(c, "restart")'>@L["Containers_Restart"]</button>
                                }
                                else
                                {
                                    <button type="button" class="link" @onclick='() => ActAsync(c, "start")'>@L["Containers_Start"]</button>
                                }
                                <button type="button" class="link" @onclick="() => ShowLogsAsync(c)">@L["Containers_Logs"]</button>
                                @if (c.State != ContainerState.Running)
                                {
                                    <ConfirmButton Label="@L["Common_Delete"]" OnConfirmed="() => RemoveContainerAsync(c)" />
                                }
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }

    @if (_logsFor is not null)
    {
        <div class="card">
            <div class="section-header">
                <h2>@L["Containers_Logs"]: @_logsFor.Name</h2>
                <select @bind="_tail" @bind:after="ReloadLogsAsync">
                    <option value="100">100</option>
                    <option value="500">500</option>
                    <option value="2000">2000</option>
                </select>
                <button type="button" class="link" @onclick="ReloadLogsAsync">@L["Common_Reload"]</button>
                <button type="button" class="link" @onclick="() => _logsFor = null">@L["Common_Close"]</button>
            </div>
            <pre class="logs">@(string.IsNullOrEmpty(_logs) ? L["Containers_LogsEmpty"] : _logs)</pre>
        </div>
    }
</section>

@if (_runtime?.SupportsPods == true && _pods is { Count: > 0 })
{
    <section>
        <h2>Pod</h2>
        <table>
            <thead>
                <tr><th>@L["Containers_Name"]</th><th>@L["Containers_State"]</th><th>@L["Containers_ContainerCount"]</th></tr>
            </thead>
            <tbody>
                @foreach (var p in _pods)
                {
                    <tr @key="p.Id"><td>@p.Name</td><td>@p.Status</td><td>@p.ContainerCount</td></tr>
                }
            </tbody>
        </table>
    </section>
}

<section>
    <h2>@L["Images_Title"]</h2>
    @if (_images is not null)
    {
        @if (_images.Count == 0)
        {
            <p class="muted">@L["Images_Empty"]</p>
        }
        else
        {
            <table>
                <thead>
                    <tr><th>@L["Images_Tags"]</th><th>ID</th><th>@L["Images_Size"]</th><th>@L["Images_Created"]</th><th></th></tr>
                </thead>
                <tbody>
                    @foreach (var i in _images)
                    {
                        <tr @key="i.Id">
                            <td class="mono">@(i.Tags.Count == 0 ? "<none>" : string.Join(", ", i.Tags))</td>
                            <td class="mono">@Formatting.ShortId(i.Id)</td>
                            <td>@Formatting.Bytes(i.SizeBytes)</td>
                            <td>@Formatting.DateTime(i.CreatedAt)</td>
                            <td>
                                <button type="button" class="link" disabled="@_op.Busy" @onclick="() => OpenPushAsync(i)">@L["Images_Push"]</button>
                                <ConfirmButton Label="@L["Common_Delete"]" OnConfirmed="() => RemoveImageAsync(i)" />
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    }

    @if (_push is not null)
    {
        <div class="card">
            <div class="section-header">
                <h2>@L["Images_PushTitle"]</h2>
                <button type="button" class="link" @onclick="() => _push = null">@L["Common_Close"]</button>
            </div>
            @if (_registries is { Count: 0 })
            {
                <p class="notice warn">@L["Images_PushNoRegistry"] <a href="registries">@L["Nav_Registries"]</a></p>
            }
            else
            {
                <EditForm Model="_push" OnSubmit="PushAsync" FormName="image-push" class="grid-form">
                    <label>
                        @L["Images_PushSource"]
                        <InputSelect @bind-Value="_push.Source">
                            @foreach (var name in _push.Candidates)
                            {
                                <option value="@name">@name</option>
                            }
                        </InputSelect>
                    </label>
                    <label>
                        @L["Images_PushRegistry"]
                        <InputSelect @bind-Value="_push.Registry">
                            @foreach (var r in _registries ?? [])
                            {
                                <option value="@r.Registry">@r.Registry</option>
                            }
                        </InputSelect>
                    </label>
                    <label>@L["Images_PushRepository"]<InputText @bind-Value="_push.Repository" placeholder="app/web" /></label>
                    <label>@L["Images_PushTag"]<InputText @bind-Value="_push.Tag" placeholder="1.0.0" /></label>
                    <div class="form-actions">
                        <button type="submit" class="primary" disabled="@_op.Busy">@(_op.Busy ? L["Common_Processing"] : L["Images_Push"])</button>
                        <span class="hint mono">@_push.Target</span>
                    </div>
                </EditForm>
            }
        </div>
    }

    <div class="card">
        <h2>@L["Images_Pull"]</h2>
        <EditForm Model="_pull" OnSubmit="PullAsync" FormName="pull-image" class="grid-form">
            <label>
                @L["Images_Name"]
                <InputText @bind-Value="_pull.Image" placeholder="registry.local:5000/app:1.0" />
            </label>
            <div class="form-actions">
                <button type="submit" class="primary" disabled="@_op.Busy">@L["Images_Pull"]</button>
            </div>
        </EditForm>
    </div>

    <div class="card">
        <h2>@L["Images_Import"]</h2>
        <p class="hint">@L["Images_ImportHint"]</p>
        <ImageDropZone NodeId="Selection.NodeId" NodeName="@Selection.NodeName" OnImported="ReloadImagesAsync" />
    </div>
</section>

@code {
    private readonly PageOperation _op = new();
    private ContainerRuntimeResponse? _runtime;
    private List<ContainerInfo>? _containers;
    private List<PodInfo>? _pods;
    private List<ImageInfo>? _images;
    private string? _unavailable;
    private bool _showInfra;
    private string? _busyId;
    private ContainerInfo? _logsFor;
    private string? _logs;
    private int _tail = 100;
    private readonly PullForm _pull = new();

    private List<ContainerInfo> VisibleContainers => _containers!.Where(c => _showInfra || !c.IsInfra).ToList();

    protected override async Task LoadAsync()
    {
        _unavailable = null;
        _runtime = null;
        _containers = null;
        _images = null;
        _pods = null;
        _logsFor = null;
        try
        {
            _runtime = await Api.GetContainerRuntimeAsync();
        }
        catch (ApiException ex) when (ex.StatusCode is HttpStatusCode.NotImplemented or HttpStatusCode.BadGateway)
        {
            _unavailable = ex.Message;
            return;
        }
        await LoadListsAsync();
    }

    private async Task LoadListsAsync()
    {
        await RunAsync(async () =>
        {
            _containers = await Api.GetContainersAsync();
            _images = await Api.GetImagesAsync();
            _pods = _runtime?.SupportsPods == true ? await Api.GetPodsAsync() : [];
        });
    }

    private async Task ActAsync(ContainerInfo container, string action)
    {
        _busyId = container.Id;
        await RunAsync(async () =>
        {
            await Api.ContainerActionAsync(container.Id, action);
            _containers = await Api.GetContainersAsync();
        });
        _busyId = null;
    }

    private async Task RemoveContainerAsync(ContainerInfo container)
    {
        await RunAsync(async () =>
        {
            await Api.RemoveContainerAsync(container.Id);
            if (_logsFor?.Id == container.Id) _logsFor = null;
            _containers = await Api.GetContainersAsync();
        });
    }

    private async Task ShowLogsAsync(ContainerInfo container)
    {
        _logsFor = container;
        await ReloadLogsAsync();
    }

    private async Task ReloadLogsAsync()
    {
        if (_logsFor is null) return;
        await RunAsync(async () => _logs = (await Api.GetContainerLogsAsync(_logsFor.Id, _tail)).Logs);
    }

    private async Task RemoveImageAsync(ImageInfo image)
    {
        await RunAsync(async () =>
        {
            await Api.RemoveImageAsync(image.Id);
            _images = await Api.GetImagesAsync();
        });
    }

    private async Task PullAsync()
    {
        if (string.IsNullOrWhiteSpace(_pull.Image))
        {
            _op.Error = L["Common_RequiredAll"];
            return;
        }
        await RunAsync(async () =>
        {
            await Api.PullImageAsync(_pull.Image.Trim());
            _op.Message = string.Format(L["Images_Pulled"], _pull.Image.Trim());
            _pull.Image = "";
            _images = await Api.GetImagesAsync();
        });
    }

    private PushForm? _push;
    private List<RegistryView>? _registries;

    /// <summary>Push の入力欄を開く。送り先のリポジトリ・タグは元の名前から補う（例: docker.io/library/busybox:latest → library/busybox, latest）。</summary>
    private async Task OpenPushAsync(ImageInfo image)
    {
        await RunAsync(async () => _registries = await Api.GetRegistriesAsync());
        var source = image.Tags.FirstOrDefault() ?? Formatting.ShortId(image.Id);
        var (repository, tag) = SplitName(source);
        _push = new PushForm
        {
            Candidates = image.Tags.Count > 0 ? [.. image.Tags] : [Formatting.ShortId(image.Id)],
            Source = source,
            Registry = _registries?.FirstOrDefault()?.Registry ?? "",
            Repository = repository,
            Tag = tag,
        };
    }

    private async Task PushAsync()
    {
        var push = _push!;
        await RunAsync(async () =>
        {
            await Api.PushImageAsync(push.Source, push.Target);
            _op.Message = string.Format(L["Images_Pushed"], push.Source, push.Target);
            _push = null;
            _images = await Api.GetImagesAsync();
        });
    }

    /// <summary>イメージ名からレジストリを除いたリポジトリとタグ。IDなら空。</summary>
    private static (string Repository, string Tag) SplitName(string name)
    {
        if (!name.Contains('/') && !name.Contains(':')) return ("", "latest");
        var slash = name.IndexOf('/');
        if (slash > 0 && name[..slash] is var first && (first.Contains('.') || first.Contains(':') || first == "localhost"))
            name = name[(slash + 1)..];
        var colon = name.LastIndexOf(':');
        return colon > 0 ? (name[..colon], name[(colon + 1)..]) : (name, "latest");
    }

    private sealed class PushForm
    {
        public List<string> Candidates { get; init; } = [];
        public string Source { get; set; } = "";
        public string Registry { get; set; } = "";
        public string Repository { get; set; } = "";
        public string Tag { get; set; } = "";
        public string Target => $"{Registry}/{Repository.Trim().Trim('/')}:{Tag.Trim()}";
    }

    private async Task ReloadImagesAsync()
    {
        await RunAsync(async () => _images = await Api.GetImagesAsync());
        StateHasChanged();
    }

    private Task RunAsync(Func<Task> action) => _op.RunAsync(action);


    private sealed class PullForm
    {
        public string Image { get; set; } = "";
    }
}
